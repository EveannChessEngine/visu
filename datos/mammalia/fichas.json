  {
   "id": "rupicapra-pyrenaica",
   "comun": "Rebeco cantábrico",
   "alternativos": [
    "Rebeco",
    "Sarrio"
   ],
   "cientifico": "Rupicapra pyrenaica",
   "orden": "Artiodactyla",
   "familia": "Bovidae",
   "rasgos": [
    "Cuernos finos, verticales y ganchudos en ambos sexos.",
    "Máscara facial oscura sobre fondo claro desde el ojo al hocico.",
    "Cuerpo esbelto; pelaje pardo-rojizo en verano y oscuro en invierno.",
    "Habitante de la alta montaña cantábrica y pirenaica."
   ],
   "imagenes": [
