   "id": "capreolus-capreolus",
   "comun": "Corzo",
   "alternativos": [],
   "cientifico": "Capreolus capreolus",
   "orden": "Artiodactyla",
   "familia": "Cervidae",
   "rasgos": [
    "Cérvido más pequeño; cuernas cortas (máximo 3 puntas por lado).",
    "Escudo anal blanco muy visible (forma de riñón o corazón).",
    "Carece de cola visible. Bozo negro en el hocico.",
    "Grito de alarma similar a un ladrido de perro."
   ],
