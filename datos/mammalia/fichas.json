   "id": "capra-pyrenaica",
   "comun": "Cabra montés",
   "alternativos": [],
   "cientifico": "Capra pyrenaica",
   "orden": "Artiodactyla",
   "familia": "Bovidae",
   "rasgos": [
    "Grandes cuernos nudosos en forma de lira en los machos.",
    "Coloración grisácea con marcadas libreas negras en patas y costados.",
    "Pezuñas adaptadas a la tracción en terrenos escarpados y rocosos.",
    "Hembras con cuernos mucho más cortos y delgados."
   ],
