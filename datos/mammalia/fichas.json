  {
   "id": "ovis-orientalis-musimon",
   "comun": "Muflón",
   "alternativos": [],
   "cientifico": "Ovis orientalis musimon",
   "orden": "Artiodactyla",
   "nombre_inat": "Ovis aries musimon",
   "familia": "Bovidae",
   "rasgos": [
    "Oveja salvaje; machos con grandes cuernos rugosos en espiral.",
    "Machos presentan una \"silla\" blanca transversal en el lomo.",
    "Pelaje corto de color pardo o castaño uniforme.",
    "Especie introducida en la península con fines cinegéticos."
   ],
