  {
   "id": "cervus-elaphus",
   "comun": "Ciervo común",
   "alternativos": [
    "Ciervo"
   ],
   "cientifico": "Cervus elaphus",
   "orden": "Artiodactyla",
   "familia": "Cervidae",
   "rasgos": [
    "Gran tamaño; machos con cuernas ramificadas que mudan anualmente.",
    "Escudo anal de color crema o pálido sin bordes negros definidos.",
    "Pelaje pardo uniforme, más grisáceo y denso en invierno.",
    "Crías (gabatos) moteadas de blanco durante los primeros meses.",
    "Nota: las hembras no tienen cuerna alguna."
   ],
   "imagenes": [
    "img/cervus-elaphus_1.jpg"
