   "alternativos": [],
   "cientifico": "Sus scrofa",
   "orden": "Artiodactyla",
   "familia": "Suidae",
   "rasgos": [
    "Cuerpo robusto cubierto de cerdas gruesas; cabeza masiva.",
    "Hocico terminado en disco nasal plano (jeta) y colmillos curvos.",
