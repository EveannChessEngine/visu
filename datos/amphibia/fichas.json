  {
   "id": "triturus-pygmaeus",
   "comun": "Tritón pigmeo",
   "alternativos": [],
   "cientifico": "Triturus pygmaeus",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "Muy similar al jaspeado pero de menor tamaño.",
    "Distribución limitada al centro y sur de la península.",
    "Vientre más claro (blanquecino o amarillento) que el marmoratus.",
    "Jaspeado negro sobre fondo verde menos intenso.",
    "Nota: más esbelto; las manchas negras no se unen."
   ],
