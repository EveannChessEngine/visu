  {
   "id": "chioglossa-lusitanica",
   "comun": "Salamandra rabilarga",
   "alternativos": [],
   "cientifico": "Chioglossa lusitanica",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "Cuerpo extremadamente esbelto y alargado.",
    "Cola que mide más del doble que el resto del cuerpo.",
    "Dos bandas doradas longitudinales que convergen en la base de la cola.",
    "Gran capacidad de autotomía caudal (pierde la cola fácilmente)."
   ],
