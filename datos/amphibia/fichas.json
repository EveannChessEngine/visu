  {
   "id": "pleurodeles-waltl",
   "comun": "Gallipato",
   "alternativos": [],
   "cientifico": "Pleurodeles waltl",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "El anfibio urodelo más grande de Europa (hasta 30 cm).",
    "Puntos anaranjados laterales que corresponden a los extremos de las costillas.",
    "Cabeza muy ancha y aplastada.",
    "Cola comprimida lateralmente en toda su longitud."
   ],
