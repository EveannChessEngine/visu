   "id": "lissotriton-helveticus",
   "comun": "Tritón palmeado",
   "alternativos": [],
   "cientifico": "Lissotriton helveticus",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "Machos con pies posteriores palmeados (membranas negras).",
    "Cola que termina en un filamento corto en los machos.",
    "Garganta blanca o rosada, generalmente sin manchas.",
    "Dorso pardo u oliváceo con dos líneas longitudinales claras."
   ],
