   "id": "ichthyosaura-alpestris",
   "comun": "Tritón alpino",
   "alternativos": [],
   "cientifico": "Ichthyosaura alpestris",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "Vientre de color naranja intenso o rojo, sin manchas.",
    "Dorso gris azulado o azulado (especialmente machos en celo).",
    "Machos con cresta baja, blanca con manchas negras.",
    "Costados moteados de blanco y azul."
