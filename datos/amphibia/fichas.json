  {
   "id": "salamandra-salamandra",
   "comun": "Salamandra común",
   "alternativos": [
    "Salamandra"
   ],
   "cientifico": "Salamandra salamandra",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "Diseño de fondo negro con manchas o bandas amarillas muy vivas.",
    "Glándulas parótidas muy visibles detrás de los ojos.",
    "Cuerpo robusto y piel brillante.",
    "Especie terrestre que solo acude al agua para depositar larvas."
   ],
