  {
   "id": "triturus-marmoratus",
   "comun": "Tritón jaspeado",
   "alternativos": [],
   "cientifico": "Triturus marmoratus",
   "orden": "Urodela",
   "familia": "Salamandridae",
   "rasgos": [
    "Coloración verde brillante con jaspeado negro muy marcado.",
    "Línea dorsal naranja muy llamativa (hembras y juveniles).",
    "Machos con gran cresta dorsal y caudal alta en celo.",
    "Vientre oscuro con pequeños puntos blancos.",
    "Nota: más rechoncho que el pigmeo; las manchas oscuras se funden."
   ],
   "imagenes": [
    "img/triturus-marmoratus_1.jpg",
    "img/triturus-marmoratus_2.jpg"
