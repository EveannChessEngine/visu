   "cientifico": "Petromyzon marinus",
   "orden": "Petromyzontiformes",
   "familia": "Petromyzontidae",
   "rasgos": [
    "Gran disco bucal succionador erizado de dientes córneos circulares.",
    "Cuerpo serpentiforme jaspeado de manchas oscuras.",
    "Aletas dorsales contiguas, casi unidas en la base.",
    "Parásito externo de grandes peces y mamíferos marinos."
