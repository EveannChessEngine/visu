   "alternativos": [],
   "cientifico": "Dasyatis pastinaca",
   "orden": "Myliobatiformes",
   "familia": "Dasyatidae",
   "rasgos": [
    "Disco romboidal con bordes anteriores rectos.",
    "Cola en forma de látigo provista de un aguijón venenoso aserrado.",
    "Carece de aleta caudal y de aguijones en el disco dorsales.",
    "Piel lisa de color gris-oliváceo uniforme."
