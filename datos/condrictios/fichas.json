  {
   "id": "prionace-glauca",
   "comun": "Tintorera / Tiburón azul",
   "alternativos": [
    "Tintorera",
    "Tiburón azul"
   ],
   "cientifico": "Prionace glauca",
   "orden": "Carcharhiniformes",
   "familia": "Carcharhinidae",
   "rasgos": [
    "Cuerpo muy estilizado con dorso de color azul índigo intenso.",
    "Aletas pectorales muy largas y estrechas.",
    "Hocico cónico y alargado; ojos grandes y redondos.",
    "Tiburón oceánico muy frecuente en el Mediterráneo español."
   ],
