  {
   "id": "galeorhinus-galeus",
   "comun": "Cazón / Tope",
   "alternativos": [
    "Cazón",
    "Tope"
   ],
   "cientifico": "Galeorhinus galeus",
   "orden": "Carcharhiniformes",
   "familia": "Triakidae",
   "rasgos": [
    "Cuerpo esbelto con hocico largo, puntiagudo y ligeramente translúcido.",
    "Aleta anal de tamaño similar a la segunda aleta dorsal.",
    "Lobo terminal de la aleta caudal muy grande y marcadamente lobulado.",
    "Ojos ovalados con membrana nictitante; dientes pequeños y aserrados oblicuamente."
   ],
   "imagenes": [
