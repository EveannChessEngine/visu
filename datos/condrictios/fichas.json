  {
   "id": "isurus-oxyrinchus",
   "comun": "Marrajo",
   "alternativos": [],
   "cientifico": "Isurus oxyrinchus",
   "orden": "Lamniformes",
   "familia": "Lamnidae",
   "rasgos": [
    "Cuerpo fusiforme robusto; el tiburón más veloz del mundo.",
    "Hocico puntiagudo y dientes finos, curvados y sin serrar.",
    "Hendiduras branquiales muy largas que llegan al dorso.",
    "Cola en forma de media luna casi simétrica."
   ],
