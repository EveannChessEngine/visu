  {
   "id": "carcharhinus-plumbeus",
   "comun": "Tiburón trozo / Tiburón plomo",
   "alternativos": [
    "Tiburón trozo",
    "Tiburón plomo"
   ],
   "cientifico": "Carcharhinus plumbeus",
   "orden": "Carcharhiniformes",
   "familia": "Carcharhinidae",
   "rasgos": [
    "Primera aleta dorsal inusualmente alta, grande y de base ancha.",
    "El origen de la primera dorsal se sitúa directamente sobre la base de las pectorales.",
    "Presencia de una cresta dérmica inter-dorsal longitudinal bien definida.",
    "Hocico corto y redondeado; coloración gris-azulada uniforme."
   ],
   "imagenes": [
