   "id": "raja-clavata",
   "comun": "Raya de clavos",
   "alternativos": [],
   "cientifico": "Raja clavata",
   "orden": "Rajiformes",
   "familia": "Rajidae",
   "rasgos": [
    "Superficie dorsal cubierta de tubérculos óseos con espinas (clavos).",
    "Hocico corto y obtuso; disco con bordes angulosos.",
    "Fila media de espinas que recorre todo el dorso hasta la cola.",
    "Coloración parda jaspeada de manchas claras y oscuras."
