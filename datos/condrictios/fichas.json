  {
   "id": "scyliorhinus-canicula",
   "comun": "Pintarroja",
   "alternativos": [],
   "cientifico": "Scyliorhinus canicula",
   "orden": "Carcharhiniformes",
   "familia": "Scyliorhinidae",
   "rasgos": [
    "Tiburón pequeño con piel rugosa moteada de manchas oscuras.",
    "Válvulas nasales unidas formando un velo nasal continuo.",
    "Aletas dorsales muy retrasadas, detrás de las pélvicas.",
    "Es el tiburón más abundante en los mercados españoles."
   ],
