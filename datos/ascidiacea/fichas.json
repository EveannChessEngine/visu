  {
   "id": "ascidia-mentula",
   "comun": "Ascidia común",
   "alternativos": [
    "Ascidia"
   ],
   "cientifico": "Ascidia mentula",
   "subfilo": "Urochordata",
   "familia": "Ascidiidae",
   "rasgos": [
    "Cuerpo solitario, oblongo y de consistencia cartilaginosa coriácea.",
    "Túnica gruesa de color translúcido a rojizo o rosáceo opaco.",
    "Sifón inhalante (bucal) terminal y sifón exhalante lateral y algo retrasado."
   ],
