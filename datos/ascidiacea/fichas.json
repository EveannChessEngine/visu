  {
   "id": "ciona-intestinalis",
   "comun": "Ciona / Ascidia intestinal",
   "alternativos": [
    "Ciona",
    "Ascidia intestinal"
   ],
   "cientifico": "Ciona intestinalis",
   "subfilo": "Urochordata",
   "familia": "Cionidae",
   "rasgos": [
    "Cuerpo alargado, cilíndrico, muy blando y flexible al tacto.",
    "Túnica translúcida de color verde pálido o amarillento.",
    "Bordes de los sifones adornados con característicos puntos de color amarillo o naranja vivos.",
    "Se observan con facilidad las bandas musculares longitudinales internas."
   ],
